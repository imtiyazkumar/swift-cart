PORT=8080
APP_ENV=development
ENVIRONMENT=development
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/yember?sslmode=disable
POSTGRES_DSN_DOCKER=postgres://postgres:postgres@postgres:5432/yember?sslmode=disable
POSTGRES_DB=yember
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-for-your-local-database
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_HASH_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
LOCAL_SEED_PASSWORD=YemberLocal!2026
LOG_LEVEL=info
ADMIN_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://localhost:8082,http://localhost:8083
PUBLIC_API_BASE_URL=http://localhost:8080
DOCUMENT_LOCAL_DIR=.private-documents

# Explicit order policy. Monetary amounts are paise; commission is basis points.
DELIVERY_FEE_PAISE=0
RESTAURANT_COMMISSION_BPS=0
# Registration is fixed: restaurant INR 200; rider INR 150; non-refundable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Backend-only AES-256 key ring: key id -> base64-encoded 32-byte key.
FINANCE_BANK_KEYS={}
FINANCE_BANK_ACTIVE_KEY=

# Phone OTP transport. No notification/outbox tables are required.
TEXTBEE_DELIVERY_ENABLED=false
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TRUST_PROXY_CIDRS=
