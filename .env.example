PORT=8080
APP_ENV=development
ENVIRONMENT=development
# Local fixtures only. Change this before first seeding if desired.
LOCAL_SEED_PASSWORD=YemberLocal!2026
# Local HTTP development only. Set true behind production HTTPS.
ADMIN_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://localhost:8082,http://localhost:8083
LOG_LEVEL=info
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/yember_local?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINS=15
REFRESH_EXPIRE_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=yember://auth/reset-password
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DELIVERY_ENABLED=false
EMAIL_VERIFICATION_URL=https://your-partner-site.example/verify-email
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIRECTORY=.private-documents
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ENDPOINT=
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
AWS_REGION=
# Prefer workload identity in production. Never put these in a client environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://your-partner-site.example/payment/success
PAYMENT_CANCEL_URL=https://your-partner-site.example/payment/cancel

RESTAURANT_PASSWORD_RESET_URL=yember-restaurant://reset-password
DELIVERY_PASSWORD_RESET_URL=yember-delivery://reset-password
RESTAURANT_EMAIL_VERIFICATION_URL=yember-restaurant://verify-email
DELIVERY_EMAIL_VERIFICATION_URL=yember-delivery://verify-email

# Backend only. Never copy secrets into Expo/Vite environment variables.
CUSTOMER_PAYMENT_METHOD=CASH_ON_DELIVERY
ONBOARDING_PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FINANCE_LIVE_APPROVED=false
FINANCE_BANK_KEYS={}
FINANCE_BANK_ACTIVE_KEY=
FINANCE_PAYOUT_PROVIDER=BANK_RECONCILIATION
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
FINANCE_SCHEDULER_ENABLED=false
FINANCE_AUTOMATION_ADMIN_ID=
ADMIN_MFA_REQUIRED=false
# JSON map of admin UUID to base32 TOTP secret. Provision securely, no committed values.
ADMIN_TOTP_SECRETS={}
OTP_HASH_SECRET=
TEXTBEE_DELIVERY_ENABLED=false
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
DOCUMENT_CLAMAV_ADDRESS=
DELIVERY_PROOF_REQUIRED=false
# Only deployed reverse-proxy network ranges. Empty trusts no forwarding proxy.
TRUST_PROXY_CIDRS=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
EXPO_PUSH_ACCESS_TOKEN=
