                {
                    "name": "Delete customer",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/customer/{{customerId}}",
                        "description": "Deletes the customer at customerId. Returns 204 with no response body."
                    },
                    "response": []
                }
            ]
        },
        {
