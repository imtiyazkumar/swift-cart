        {
            "name": "Delivery",
            "description": "Delivery operations use an existing delivery partner. There is no HTTP endpoint in this API for creating a partner; set partnerId in the environment to a provisioned partner ID before using partner routes.",
            "item": [
                {
                    "name": "Set partner online",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/delivery/partners/{{partnerId}}/online",
                        "description": "Marks the existing partner online. Returns 204 with no response body. The partner ID must exist in the database."
                    },
                    "response": []
                },
                {
                    "name": "Set partner offline",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": "{{baseUrl}}/api/v1/delivery/partners/{{partnerId}}/offline",
                        "description": "Marks the existing partner offline. Returns 204 with no response body. The partner ID must exist in the database."
                    },
                    "response": []
