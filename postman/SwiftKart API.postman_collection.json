                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "  const payload = pm.response.json();",
                                    "  if (payload.id) pm.environment.set('categoryId', payload.id);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "response": []
