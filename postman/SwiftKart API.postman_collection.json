                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"merchant_id\": \"{{merchantId}}\",\n  \"category_id\": \"{{categoryId}}\",\n  \"name\": \"Seasonal apples\",\n  \"description\": \"Crisp locally sourced apples\",\n  \"item_type\": \"STANDARD\",\n  \"is_vegetarian\": true,\n  \"base_price\": 14900,\n  \"currency\": \"INR\",\n  \"inventory_tracked\": false,\n  \"substitution_policy\": \"NONE\"\n}",
