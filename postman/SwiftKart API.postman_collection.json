                    "response": []
                }
            ]
        },
        {
            "name": "Payments",
            "description": "Create a payment intent for an existing order. The example uses defaults made explicit: RAZORPAY and UPI; currency defaults to INR.",
            "item": [
                {
                    "name": "Create payment intent",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"provider\": \"RAZORPAY\",\n  \"method\": \"UPI\",\n  \"amount\": 14900,\n  \"currency\": \"INR\",\n  \"idempotency_key\": \"swiftkart-{{orderId}}-payment-1\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/payments/intents",
                        "description": "Creates a payment intent. Required: order_id and positive amount. provider defaults to RAZORPAY, method to UPI, and currency to INR. Returns 201 with the created intent. The order must exist."
                    },
                    "response": []
                }
            ]
        }
    ]
}
