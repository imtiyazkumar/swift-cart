        {
            "name": "Orders",
            "description": "Order creation requires merchant_id and customer_id. Create customer and merchant first. The create response stores orderId.",
            "item": [
                {
                    "name": "Create order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"merchant_id\": \"{{merchantId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"total_price\": 14900\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/order/create",
                        "description": "Creates an order. Required: merchant_id and customer_id. The service assigns an ID, timestamps, and CREATED status. Returns 201."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "  const payload = pm.response.json();",
                                    "  if (payload.id) pm.environment.set('orderId', payload.id);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "response": []
                },
