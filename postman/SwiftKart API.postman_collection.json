{
    "info": {
        "_postman_id": "2f0ea0f2-71bc-49d5-b8b8-983281641229",
        "name": "SwiftKart API",
        "description": "Complete Postman collection for the SwiftKart API. Import this collection and SwiftKart Local.postman_environment.json, select the environment, then set baseUrl and authEmail/authPassword if needed. Start the API and PostgreSQL first. Only GET /api/v1/auth/me requires a bearer token; the other business endpoints are currently not JWT-protected by the server. Creation requests save returned IDs into environment variables where practical. The delivery API has no partner-creation route, so partnerId must refer to an existing delivery partner. Prices and payment amounts are represented as numeric values; currency defaults to INR in the service when omitted.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Service and Health",
            "description": "Root status page and health endpoints. Readiness checks the PostgreSQL connection.",
            "item": [
                {
                    "name": "Home page",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "text/html"
                            }
                        ],
                        "url": "{{baseUrl}}/",
                        "description": "Returns the SwiftKart HTML service status page (200 text/html)."
                    },
                    "response": []
                },
                {
                    "name": "Liveness",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/healthz",
                        "description": "Process liveness check. Returns plain text OK with HTTP 200."
                    },
                    "response": []
                },
                {
                    "name": "Readiness",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/readyz",
                        "description": "Database readiness check. Returns READY with HTTP 200, or DB not ready with HTTP 503."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Authentication",
            "description": "Signup and login return JWT tokens. Signup defaults role to customer when omitted. Only Get current user uses JWT middleware.",
            "item": [
                {
                    "name": "Sign up",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"role\": \"customer\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/auth/signup",
                        "description": "Creates a user. email and password are required; role is optional and defaults to customer. Returns 201 with id, email, and role. The email must be unique."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "  const payload = pm.response.json();",
                                    "  if (payload.id) pm.environment.set('authUserId', payload.id);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "response": []
                },
                {
                    "name": "Log in",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/auth/login",
                        "description": "Authenticates a user. Returns 200 with access_token and refresh_token; invalid credentials return 401. Saves returned tokens into the selected Postman environment."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "  const payload = pm.response.json();",
                                    "  if (payload.access_token) pm.environment.set('accessToken', payload.access_token);",
                                    "  if (payload.refresh_token) pm.environment.set('refreshToken', payload.refresh_token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "response": []
                },
                {
                    "name": "Refresh access token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/auth/refresh",
                        "description": "Exchanges a valid refresh token for a new access_token. Returns 200; an invalid token returns 401. Saves the new access token to the selected environment."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "  const payload = pm.response.json();",
                                    "  if (payload.access_token) pm.environment.set('accessToken', payload.access_token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "response": []
                },
                {
                    "name": "Get current user",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{accessToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/api/v1/auth/me",
                        "description": "Returns the authenticated user profile. Requires Authorization: Bearer {{accessToken}}. Returns 200; absent or invalid tokens return 401."
                    },
                    "response": []
                }
            ]
        },
        {
