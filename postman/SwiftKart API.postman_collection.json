                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/v1/delivery/assignments",
                        "description": "Creates an order-partner assignment. Required: order_id and partner_id. Returns 201 with the assignment. Both records must exist."
